{
  "name": "rich-tex-editor",
  "version": "0.2.0",
  "private": true,
  "description": "Source for the Rich TeX Editor Orca plugin. `npm run build` bundles src/ into editor/app.js.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "orca plugin test . && node scripts/test-editor.mjs",
    "test:editor": "node scripts/test-editor.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "katex": "0.19.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
